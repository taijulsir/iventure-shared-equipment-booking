# PostgreSQL configuration used by docker-compose.yml for local development.
# Copy this file to `.env` and adjust values as needed. Never commit the real `.env`.

POSTGRES_DB=iventure
POSTGRES_USER=iventure
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_PORT=5432
# If port 5432 is already in use on your machine (e.g. a locally installed
# PostgreSQL service), change this to another port such as 5433 and update
# DATABASE_URL in backend/.env to match.
