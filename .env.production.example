# Production environment file for docker-compose.prod.yml.
#
# Copy this to `.env.production` ON THE VPS ONLY (never in this repo, never
# in GitHub Actions). It is git-ignored; the deployment workflow does not
# create, read, or transmit it — it is managed entirely on the server. See
# docs/deployment.md for the full setup runbook.

# --- PostgreSQL -----------------------------------------------------------

POSTGRES_DB=iventure
POSTGRES_USER=iventure
POSTGRES_PASSWORD=replace-with-a-long-random-value

# Must reference the `postgres` service name (Docker Compose's internal
# network DNS), not localhost — the backend container resolves it there.
DATABASE_URL="postgresql://iventure:replace-with-a-long-random-value@postgres:5432/iventure?schema=public"

# --- Backend ----------------------------------------------------------------

NODE_ENV=production

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN=1h

# `lax` is sufficient as long as the frontend and backend are deployed
# same-site (e.g. both behind the same reverse-proxy domain, or on
# sibling subdomains reached through one proxy). Only use `none` if they
# are genuinely different sites.
COOKIE_SAME_SITE=lax

# Exact public origin the frontend is served from (scheme + host, no
# trailing slash, no path). Required for CORS + the auth cookie.
FRONTEND_ORIGIN=https://app.example.com

# Optional host loopback port publishing overrides (defaults to 3000 and 3001)
BACKEND_PORT=3000
FRONTEND_PORT=3001

# --- Frontend -----------------------------------------------------------

# Exact public origin the backend API is reachable at, as seen by the
# browser. Baked into the frontend's client bundle at build time (see
# frontend/Dockerfile) — changing this requires rebuilding the frontend
# image, not just restarting the container.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# --- SuperAdmin bootstrap (one-time) --------------------------------------

# Only read by `node dist/scripts/seed-superadmin.js`, run manually once
# after the first deployment (see docs/deployment.md) — never by the
# running application itself. Safe to remove from this file afterward;
# re-running the script with the same email is idempotent (see
# backend/src/scripts/seed-superadmin.ts).
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=replace-with-a-strong-password
SUPERADMIN_NAME="Super Admin"
