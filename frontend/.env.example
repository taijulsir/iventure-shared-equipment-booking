# Copy this file to `.env.local` and adjust if needed. Never commit the real `.env.local`.

# Base URL of the backend API. Must be an exact origin (scheme + host + port),
# no trailing slash and no path. `NEXT_PUBLIC_` is required because this value
# is read from the browser (client components call the backend directly with
# credentials: 'include' for the auth cookie) as well as from the server.
#
# This is not a secret — it is compiled into the client bundle either way.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
