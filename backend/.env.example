# Copy this file to `.env` and adjust values for your local environment.
# Never commit the real `.env` file.

# PostgreSQL connection string used by Prisma.
# Matches the credentials defined in the repository root's docker-compose.yml / .env.example
# when running PostgreSQL locally via Docker Compose.
# If you changed POSTGRES_PORT in the root .env because 5432 was already in use
# (e.g. 5433), update the port below to match.
DATABASE_URL="postgresql://iventure:change-me-in-local-env@localhost:5432/iventure?schema=public"

# Port the NestJS application listens on.
PORT=3000

# development | production — affects the auth cookie's `secure` flag (forced
# on in production) and CORS/cookie defaults. Leave as `development` locally.
NODE_ENV=development

# --- Authentication -----------------------------------------------------

# Secret used to sign and verify JWTs. Generate a long random value for real
# use, e.g.: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
# Never reuse this example value anywhere real.
JWT_SECRET=replace-with-a-long-random-value

# JWT lifetime. Kept short-lived and simple for this assessment — no refresh
# tokens or server-side revocation (see docs/decisions.md, "JWT Lifecycle").
JWT_EXPIRES_IN=1h

# SameSite policy for the auth cookie: lax | strict | none.
# `lax` (the default if unset) is sufficient CSRF protection as long as the
# frontend and backend are deployed same-site (including different ports on
# localhost). Only set this to `none` if the deployed frontend and backend
# end up on genuinely different sites — and if you do, an explicit CSRF
# token mechanism is also required (not implemented in this phase).
COOKIE_SAME_SITE=lax

# --- SuperAdmin bootstrap (backend/src/scripts/seed-superadmin.ts) --------

# Required only when running `npm run seed:superadmin`. Unlike the
# seed:admin fixture, there is no hardcoded fallback here — the script
# refuses to run unless all three are set. Exactly one SuperAdmin account is
# expected to exist system-wide; re-running the script with the same email is
# safe (idempotent), but running it with a different email while a SuperAdmin
# already exists is refused rather than creating a second one.
# Never commit real values for these.
SUPERADMIN_EMAIL=superadmin@iventure.local
SUPERADMIN_PASSWORD=change-me-to-a-strong-local-only-password
SUPERADMIN_NAME="Super Admin"

# --- CORS -----------------------------------------------------------------

# Exact origin of the frontend app — required for the browser to send/receive
# the auth cookie cross-origin. Never a wildcard. The frontend's Next.js dev
# server also defaults to port 3000, the same as this backend's default PORT
# above, so when running both locally start the frontend on another port
# (e.g. `next dev -p 3001`) or change one of the two ports.
FRONTEND_ORIGIN=http://localhost:3001
