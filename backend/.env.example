# Copy this file to `.env` and adjust values for your local environment.
# Never commit the real `.env` file.

# PostgreSQL connection string used by Prisma.
# Matches the credentials defined in the repository root's docker-compose.yml / .env.example
# when running PostgreSQL locally via Docker Compose.
# If you changed POSTGRES_PORT in the root .env because 5432 was already in use
# (e.g. 5433), update the port below to match.
DATABASE_URL="postgresql://iventure:change-me-in-local-env@localhost:5432/iventure?schema=public"

# Port the NestJS application listens on.
PORT=3000
